generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  TRANSPORTER
  ADMIN
  BACKOFFICE
}

enum TransporterStatus {
  PENDING_DOCUMENTS
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum VehicleType {
  CAR
  VAN
  TRUCK
  MOTORCYCLE
}

enum LoadType {
  LIGHT
  HEAVY
  BOTH
}

enum VehicleStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum ValidationEntityType {
  VEHICLE
  TRANSPORTER_PROFILE
}

enum RejectionCategory {
  POOR_QUALITY_PHOTOS
  EXPIRED_DOCUMENTS
  INFORMATION_MISMATCH
  ADDITIONAL_DOCUMENTATION_REQUIRED
  OTHER
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  cognitoSub         String              @unique
  email              String              @unique
  phone              String
  firstName          String
  lastName           String
  role               UserRole            @default(CLIENT)

  // Client-specific (optional)
  companyName        String?
  taxId              String?

  // Relations
  transporterProfile TransporterProfile?
  addresses          Address[]
  vehicles           Vehicle[]
  reviewedValidations ValidationLog[]    @relation("ReviewedValidations")
  transporterValidations ValidationLog[] @relation("TransporterValidations")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model TransporterProfile {
  id                   String            @id @default(uuid()) @db.Uuid

  // License
  licenseNumber        String
  licenseExpiration    DateTime
  licenseFrontPhotoUrl String
  licenseBackPhotoUrl  String
  idPhotoUrl           String

  // Address
  address              String
  city                 String
  state                String
  postalCode           String
  country              String

  // Insurance
  insurancePolicy      String
  insuranceExpiration  DateTime
  insuranceDocumentUrl String

  // Status
  status               TransporterStatus @default(PENDING_REVIEW)

  // Relation
  userId               String            @unique @db.Uuid
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  alias        String
  street       String
  city         String
  state        String
  postalCode   String
  country      String   @default("Guatemala")
  latitude     Float?
  longitude    Float?
  contactName  String?
  contactPhone String?
  isDefault    Boolean  @default(false)

  // Relation
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Vehicle {
  id                  String        @id @default(uuid()) @db.Uuid

  // Basic Info
  brand               String
  model               String
  year                Int
  licensePlate        String        @unique
  vin                 String        @unique @db.VarChar(17)
  color               String
  vehicleType         VehicleType

  // Capacity
  loadType            LoadType
  maxWeightKg         Float
  maxVolumeM3         Float

  // Photos
  frontPhotoUrl       String
  rearPhotoUrl        String
  sidePhotoUrl        String
  interiorPhotoUrl    String

  // Documents
  registrationDocUrl  String
  insuranceDocUrl     String
  insuranceExpiration DateTime

  // Status
  status              VehicleStatus @default(PENDING_REVIEW)

  // Relation
  userId              String        @db.Uuid
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
}

model ValidationLog {
  id                String               @id @default(uuid()) @db.Uuid
  entityType        ValidationEntityType
  entityId          String               @db.Uuid
  action            String               // APPROVED, REJECTED
  rejectionCategory RejectionCategory?
  rejectionDetails  String?
  checklist         Json?

  // Reviewer (BACKOFFICE/ADMIN)
  reviewedBy        String               @db.Uuid
  reviewer          User                 @relation("ReviewedValidations", fields: [reviewedBy], references: [id])

  // Transporter being validated
  transporterId     String               @db.Uuid
  transporter       User                 @relation("TransporterValidations", fields: [transporterId], references: [id])

  emailSent         Boolean              @default(false)
  createdAt         DateTime             @default(now())

  @@index([entityType, entityId])
  @@index([transporterId])
  @@index([reviewedBy])
}
