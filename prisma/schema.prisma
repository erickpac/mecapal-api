// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  TRANSPORTER
  ADMIN
  BACKOFFICE
}

enum TransporterStatus {
  PENDING_DOCUMENTS
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum VehicleType {
  CAR
  VAN
  TRUCK
  MOTORCYCLE
}

enum LoadType {
  LIGHT
  HEAVY
  BOTH
}

enum VehicleStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum ValidationEntityType {
  VEHICLE
  TRANSPORTER_PROFILE
}

enum RejectionCategory {
  POOR_QUALITY_PHOTOS
  EXPIRED_DOCUMENTS
  INFORMATION_MISMATCH
  ADDITIONAL_DOCUMENTATION_REQUIRED
  OTHER
}

enum ZonePreference {
  PREFERRED
  NEUTRAL
  EXCLUDED
}

enum DeliveryRequestStatus {
  DRAFT
  PUBLISHED
  OFFERS_RECEIVED
  ACCEPTED
  IN_PROGRESS
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum DeliveryOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReviewType {
  CLIENT_TO_TRANSPORTER
  TRANSPORTER_TO_CLIENT
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  cognitoSub String   @unique
  email      String   @unique
  phone      String
  firstName  String
  lastName   String
  role       UserRole @default(CLIENT)

  // Client-specific (optional)
  companyName String?
  taxId       String?

  // Relations
  transporterProfile     TransporterProfile?
  addresses              Address[]
  vehicles               Vehicle[]
  reviewedValidations    ValidationLog[]             @relation("ReviewedValidations")
  transporterValidations ValidationLog[]             @relation("TransporterValidations")
  zonePreferences        TransporterZonePreference[] @relation("TransporterZonePreferences")

  // Delivery relations
  clientDeliveryRequests DeliveryRequest[] @relation("ClientDeliveryRequests")
  transporterOffers      DeliveryOffer[]   @relation("TransporterOffers")

  // Billing profile (for clients) - if null, uses global default
  billingProfileId String?         @db.Uuid
  billingProfile   BillingProfile? @relation(fields: [billingProfileId], references: [id])

  // Payment relations
  stripeCustomerId String?         @unique
  paymentMethods   PaymentMethod[] @relation("UserPaymentMethods")
  transactions     Transaction[]   @relation("UserTransactions")

  // Order relations
  clientOrders      Order[] @relation("ClientOrders")
  transporterOrders Order[] @relation("TransporterOrders")

  // Bank account relations (for transporters)
  bankAccounts BankAccount[] @relation("TransporterBankAccounts")

  // Settlement relations
  transporterSettlements  Settlement[] @relation("TransporterSettlements")
  settlementRegistrations Settlement[] @relation("SettlementRegistrations")

  // Review relations
  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  // Rating stats (cached for performance)
  averageRating Float @default(0)
  totalReviews  Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billingProfileId])
}

model TransporterProfile {
  id String @id @default(uuid()) @db.Uuid

  // License
  licenseNumber        String
  licenseExpiration    DateTime
  licenseFrontPhotoUrl String
  licenseBackPhotoUrl  String
  idPhotoUrl           String

  // Address
  address    String
  city       String
  state      String
  postalCode String
  country    String

  // Insurance
  insurancePolicy      String
  insuranceExpiration  DateTime
  insuranceDocumentUrl String

  // Status
  status TransporterStatus @default(PENDING_REVIEW)

  // Relation
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  alias        String
  street       String
  city         String
  state        String
  postalCode   String
  country      String  @default("Guatemala")
  latitude     Float?
  longitude    Float?
  contactName  String?
  contactPhone String?
  isDefault    Boolean @default(false)

  // Relation
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Delivery relations
  pickupRequests   DeliveryRequest[] @relation("PickupAddress")
  deliveryRequests DeliveryRequest[] @relation("DeliveryAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Vehicle {
  id String @id @default(uuid()) @db.Uuid

  // Basic Info
  brand        String
  model        String
  year         Int
  licensePlate String      @unique
  vin          String      @unique @db.VarChar(17)
  color        String
  vehicleType  VehicleType

  // Capacity
  loadType    LoadType
  maxWeightKg Float
  maxVolumeM3 Float

  // Photos
  frontPhotoUrl    String
  rearPhotoUrl     String
  sidePhotoUrl     String
  interiorPhotoUrl String

  // Documents
  registrationDocUrl  String
  insuranceDocUrl     String
  insuranceExpiration DateTime

  // Status
  status VehicleStatus @default(PENDING_REVIEW)

  // Relation
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Delivery relations
  deliveryOffers DeliveryOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ValidationLog {
  id                String               @id @default(uuid()) @db.Uuid
  entityType        ValidationEntityType
  entityId          String               @db.Uuid
  action            String // APPROVED, REJECTED
  rejectionCategory RejectionCategory?
  rejectionDetails  String?
  checklist         Json?

  // Reviewer (BACKOFFICE/ADMIN)
  reviewedBy String @db.Uuid
  reviewer   User   @relation("ReviewedValidations", fields: [reviewedBy], references: [id])

  // Transporter being validated
  transporterId String @db.Uuid
  transporter   User   @relation("TransporterValidations", fields: [transporterId], references: [id])

  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([transporterId])
  @@index([reviewedBy])
}

// ==================== LOCATION MODELS ====================

model Country {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  code     String  @unique @db.VarChar(3)
  isActive Boolean @default(true)

  states State[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

model State {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  code     String  @db.VarChar(10)
  isActive Boolean @default(true)

  countryId String  @db.Uuid
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  municipalities Municipality[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@index([countryId])
  @@index([isActive])
}

model Municipality {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  code     String  @db.VarChar(10)
  isActive Boolean @default(true)

  stateId String @db.Uuid
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  zones Zone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stateId, code])
  @@unique([stateId, name])
  @@index([stateId])
  @@index([isActive])
}

model Zone {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  code      String  @db.VarChar(10)
  latitude  Float?
  longitude Float?
  polygon   Json?
  isActive  Boolean @default(true)

  municipalityId String       @db.Uuid
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  transporterPreferences TransporterZonePreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([municipalityId, code])
  @@unique([municipalityId, name])
  @@index([municipalityId])
  @@index([isActive])
}

model TransporterZonePreference {
  id         String         @id @default(uuid()) @db.Uuid
  preference ZonePreference @default(NEUTRAL)

  transporterId String @db.Uuid
  transporter   User   @relation("TransporterZonePreferences", fields: [transporterId], references: [id], onDelete: Cascade)

  zoneId String @db.Uuid
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transporterId, zoneId])
  @@index([transporterId])
  @@index([zoneId])
  @@index([preference])
}

// ==================== DELIVERY MODELS ====================

model DeliveryRequest {
  id String @id @default(uuid()) @db.Uuid

  // Load type
  loadType LoadType

  // Addresses
  pickupAddressId      String  @db.Uuid
  pickupAddress        Address @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  deliveryAddressId    String  @db.Uuid
  deliveryAddress      Address @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])
  calculatedDistanceKm Float

  // Package details
  estimatedWeightKg   Float
  estimatedVolumeM3   Float?
  packageDescription  String  @db.VarChar(500)
  declaredValue       Float?
  isFragile           Boolean @default(false)
  requiresSignature   Boolean @default(false)
  specialInstructions String? @db.VarChar(300)

  // Scheduling
  pickupDate         DateTime @db.Date
  pickupTimeStart    DateTime @db.Time(0)
  pickupTimeEnd      DateTime @db.Time(0)
  deliveryDeadline   DateTime
  offerWindowMinutes Int      @default(60)
  offerExpiresAt     DateTime

  // Status
  status DeliveryRequestStatus @default(DRAFT)

  // Relations
  clientId String @db.Uuid
  client   User   @relation("ClientDeliveryRequests", fields: [clientId], references: [id])

  acceptedOfferId String? @unique @db.Uuid

  offers DeliveryOffer[] @relation("RequestOffers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([offerExpiresAt])
}

model DeliveryOffer {
  id String @id @default(uuid()) @db.Uuid

  // Offer details
  offeredPrice          Float
  estimatedTimeMinutes  Int
  estimatedPickupTime   DateTime
  estimatedDeliveryTime DateTime
  notes                 String?  @db.VarChar(500)

  // Commission details (calculated at offer creation)
  commissionType        CommissionType @default(PERCENTAGE)
  commissionPercent     Float? // If PERCENTAGE type
  commissionFixedAmount Float? // If FIXED_AMOUNT type
  commissionMinimum     Float? // Min bound applied (for tracking)
  commissionMaximum     Float? // Max bound applied (for tracking)
  commissionAmount      Float // Final calculated commission
  commissionExempt      Boolean        @default(false)

  // Tax details (calculated at offer creation)
  taxPercent Float   @default(0)
  taxAmount  Float   @default(0)
  taxExempt  Boolean @default(false)

  // Final prices
  subtotal         Float // offeredPrice + commissionAmount
  totalClientPrice Float // subtotal + taxAmount (what client pays)
  netEarnings      Float // what transporter earns (= offeredPrice)

  // Status
  status DeliveryOfferStatus @default(PENDING)

  // Relations
  deliveryRequestId String          @db.Uuid
  deliveryRequest   DeliveryRequest @relation("RequestOffers", fields: [deliveryRequestId], references: [id])

  transporterId String @db.Uuid
  transporter   User   @relation("TransporterOffers", fields: [transporterId], references: [id])

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // Payment relation
  transaction Transaction?

  // Order relation (created after payment succeeds)
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deliveryRequestId, transporterId])
  @@index([deliveryRequestId])
  @@index([transporterId])
  @@index([status])
}

// ==================== PAYMENT MODELS ====================

enum PaymentMethodType {
  CARD
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
  DISCOVER
  OTHER
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum TransactionType {
  PAYMENT
  REFUND
}

enum OrderStatus {
  CONFIRMED // Created after payment succeeds
  IN_PROGRESS // Transporter started the delivery
  PICKED_UP // Package picked up from origin
  IN_TRANSIT // On the way to destination
  DELIVERED // Delivered to destination
  COMPLETED // Order closed (after rating/settlement)
  CANCELLED // Order cancelled
}

model PaymentMethod {
  id String @id @default(uuid()) @db.Uuid

  // Stripe references
  stripePaymentMethodId String @unique
  stripeCustomerId      String

  // Card details (non-sensitive, from Stripe)
  type      PaymentMethodType @default(CARD)
  cardBrand CardBrand
  cardLast4 String            @db.VarChar(4)
  cardExpMonth Int
  cardExpYear  Int

  // User preference
  isDefault Boolean @default(false)

  // Relations
  userId       String        @db.Uuid
  user         User          @relation("UserPaymentMethods", fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid

  // Stripe references
  stripePaymentIntentId String  @unique
  stripeChargeId        String?

  // Transaction details
  type     TransactionType   @default(PAYMENT)
  status   TransactionStatus @default(PENDING)
  amount   Float // Total amount charged
  currency String            @default("USD") @db.VarChar(3)

  // Fee breakdown (snapshot at payment time)
  subtotal         Float // offeredPrice + commission
  commissionAmount Float
  taxAmount        Float

  // Refund tracking
  refundedAmount Float @default(0)

  // Error handling
  failureCode    String?
  failureMessage String?

  // Relations
  userId          String         @db.Uuid
  user            User           @relation("UserTransactions", fields: [userId], references: [id])
  paymentMethodId String?        @db.Uuid
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  deliveryOfferId String         @unique @db.Uuid
  deliveryOffer   DeliveryOffer  @relation(fields: [deliveryOfferId], references: [id])

  // Order relation
  order Order?

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([stripePaymentIntentId])
}

// ==================== BILLING PROFILES ====================

model BillingProfile {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // "Standard", "Premium", "Corporativo", etc.
  description String?

  // Commission configuration
  commissionType     CommissionType @default(PERCENTAGE)
  commissionValue    Float          @default(15) // percentage (0-100) or fixed amount in USD
  commissionMinimum  Float? // only for PERCENTAGE type - minimum commission
  commissionMaximum  Float? // only for PERCENTAGE type - maximum commission
  isCommissionExempt Boolean        @default(false)

  // Tax configuration
  taxPercent  Float   @default(0) // e.g., 5.0, 12.0
  isTaxExempt Boolean @default(false)

  // Status
  isDefault Boolean @default(false) // Only one profile can be default
  isActive  Boolean @default(true)

  // Relations
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDefault])
}

// ==================== ORDER/TRACKING MODELS ====================

model Order {
  id String @id @default(uuid()) @db.Uuid

  // Order number for human reference (e.g., ORD-2026-000001)
  orderNumber String @unique

  // Status
  status OrderStatus @default(CONFIRMED)

  // Timestamps for each status
  confirmedAt   DateTime  @default(now())
  inProgressAt  DateTime?
  pickedUpAt    DateTime?
  inTransitAt   DateTime?
  deliveredAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  // Delivery confirmation
  deliveryPhotoUrl   String?
  deliverySignature  String? // Base64 or URL
  deliveryNotes      String? @db.VarChar(500)
  receiverName       String?
  deliveredToAddress String? // Actual delivery address if different

  // Cancellation
  cancellationReason String? @db.VarChar(500)
  cancelledBy        String? @db.Uuid // User ID who cancelled

  // Relations
  deliveryOfferId String        @unique @db.Uuid
  deliveryOffer   DeliveryOffer @relation(fields: [deliveryOfferId], references: [id])

  transactionId String      @unique @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  clientId String @db.Uuid
  client   User   @relation("ClientOrders", fields: [clientId], references: [id])

  transporterId String @db.Uuid
  transporter   User   @relation("TransporterOrders", fields: [transporterId], references: [id])

  // Status history
  statusHistory OrderStatusHistory[]

  // Location updates
  locationUpdates OrderLocation[]

  // Settlement relation
  settlement Settlement?

  // Review relation
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([transporterId])
  @@index([status])
  @@index([orderNumber])
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  // Status change
  fromStatus OrderStatus?
  toStatus   OrderStatus

  // Metadata
  notes    String? @db.VarChar(500)
  changedBy String? @db.Uuid // User ID who made the change

  // Location at status change (optional)
  latitude  Float?
  longitude Float?

  // Relation
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([toStatus])
}

model OrderLocation {
  id String @id @default(uuid()) @db.Uuid

  // GPS coordinates
  latitude  Float
  longitude Float

  // Speed and heading (optional)
  speed   Float? // km/h
  heading Float? // degrees from north (0-360)

  // Accuracy
  accuracy Float? // meters

  // Relation
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// ==================== BANK ACCOUNT MODELS ====================

enum BankAccountType {
  CHECKING
  SAVINGS
}

enum SettlementStatus {
  PENDING // Order completed, waiting for admin to make transfer
  PAID    // Admin has recorded the transfer
}

enum BankAccountStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

model BankAccount {
  id String @id @default(uuid()) @db.Uuid

  // Bank details
  bankName          String
  accountHolderName String
  accountType       BankAccountType @default(CHECKING)
  accountNumber     String // Full account number (for admin to use in manual transfers)
  accountNumberLast4 String @db.VarChar(4) // For display in lists

  // Verification
  status             BankAccountStatus @default(PENDING_VERIFICATION)
  verificationDocUrl String? // Bank statement or void check image
  verifiedAt         DateTime?
  rejectionReason    String?

  // User preference
  isDefault Boolean @default(false)

  // Relations
  transporterId String @db.Uuid
  transporter   User   @relation("TransporterBankAccounts", fields: [transporterId], references: [id], onDelete: Cascade)

  // Settlement relation
  settlements Settlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transporterId])
  @@index([status])
  @@index([isDefault])
}

// ==================== SETTLEMENT MODELS ====================

model Settlement {
  id String @id @default(uuid()) @db.Uuid

  // Settlement amount (= netEarnings from the delivery offer)
  amount Float

  // Status
  status SettlementStatus @default(PENDING)

  // Payment details (filled when admin records the transfer)
  transferDate      DateTime? @db.Date
  transactionNumber String?
  comment           String?   @db.VarChar(500)
  screenshotUrl     String?
  paidAt            DateTime? // When admin recorded the payment in system

  // Relations
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id])

  transporterId String @db.Uuid
  transporter   User   @relation("TransporterSettlements", fields: [transporterId], references: [id])

  bankAccountId String?      @db.Uuid
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  registeredBy     String? @db.Uuid // Admin who recorded the payment
  registeredByUser User?   @relation("SettlementRegistrations", fields: [registeredBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transporterId])
  @@index([status])
  @@index([orderId])
}

// ==================== REVIEW MODELS ====================

model Review {
  id String @id @default(uuid()) @db.Uuid

  // Rating details
  rating  Int // 1-5 stars
  comment String? @db.VarChar(500)

  // Review type (who is reviewing whom)
  type ReviewType

  // Relations
  reviewerId String @db.Uuid
  reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  revieweeId String @db.Uuid
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, type]) // One review per type per order
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([orderId])
  @@index([type])
}
